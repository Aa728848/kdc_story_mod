exist_mpj_step_final = {
	from = {
		NOT = { check_variable = { 
			which = wg_mpj_steps_$VALUE$
			value = 0 
		}}
		check_variable_arithmetic = {
			which = $MPJ_PAGE_START$
			add = $STEP$
			value < wg_mpj_steps_$VALUE$
		}
	}
}

