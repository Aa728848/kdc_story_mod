			exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$9 STEP_VALUE = $STEP_VALUE$ }
		}
	}
}

# 初始化大型项目步骤类型
# 0x = 一次型 
# 1x = 循环型 
# 2x = 概率循环型 
# 3x = 常驻型
# 4x = 科技型
# 50 = 考古型
# 后缀：(适用于0~4)
# 0 = 国家限定 
# 1 = 物理学限定 
# 2 = 社会学限定 *
# 3 = 工程学限定 
# 4 = 物理+社会学 *
# 5 = 社会+工程学 *
# 6 = 物理+工程学 
# 7 = 所有 *
exist_mpj_society_research_final = {
	event_target:wg_player_country = {
		check_variable = { 
			which = wg_mpj_$MPJ_VALUE$_steps_type_$STEP_VALUE$ 
			value > 0 
		}
		check_variable = {
			which = wg_mpj_$MPJ_VALUE$_steps_type_$STEP_VALUE$
			value < 50
		}
		OR = {
			check_variable_arithmetic = {
				which = wg_mpj_$MPJ_VALUE$_steps_type_$STEP_VALUE$
				modulo = 10
				value = 2
			}
			check_variable_arithmetic = {
				which = wg_mpj_$MPJ_VALUE$_steps_type_$STEP_VALUE$
				modulo = 10
				value = 4
			}
			check_variable_arithmetic = {
				which = wg_mpj_$MPJ_VALUE$_steps_type_$STEP_VALUE$
				modulo = 10
				value = 5
			}
			check_variable_arithmetic = {
				which = wg_mpj_$MPJ_VALUE$_steps_type_$STEP_VALUE$
				modulo = 10
				value = 7
			}
		}
	}
}