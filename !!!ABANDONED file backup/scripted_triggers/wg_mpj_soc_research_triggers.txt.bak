exist_mpj_society_research_S4 = {
	if = {
		limit = { check_variable = { which = $MPJ$_DIGITS value = 1 }}
		exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$ STEP_VALUE = $STEP_VALUE$ }
	}
	else_if = {
		limit = { check_variable = { which = $MPJ$_DIGITS value > 1 }}
		if = {
			limit = { check_variable = { which = $MPJ$_DIGIT_2 value = 0 }}
			exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$0 STEP_VALUE = $STEP_VALUE$ }
		} else_if = {
			limit = { check_variable = { which = $MPJ$_DIGIT_2 value = 1 }}
			exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$1 STEP_VALUE = $STEP_VALUE$ }
		} else_if = {
			limit = { check_variable = { which = $MPJ$_DIGIT_2 value = 2 }}
			exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$2 STEP_VALUE = $STEP_VALUE$ }
		} else_if = {
			limit = { check_variable = { which = $MPJ$_DIGIT_2 value = 3 }}
			exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$3 STEP_VALUE = $STEP_VALUE$ }
		} else_if = {
			limit = { check_variable = { which = $MPJ$_DIGIT_2 value = 4 }}
			exist_mpj_society_research_final = { MPJ_VALUE = $MPJ_VALUE$4 STEP_VALUE = $STEP_VALUE$ }
		} else_if = {
