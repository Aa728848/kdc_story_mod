		} else_if = {
			limit = { check_variable = { which = $STEP$_DIGIT_2 value = 7 }}
			exist_mpj_society_research_S3 = { MPJ = $MPJ$ STEP_VALUE = $STEP_VALUE$7 }
		} else_if = {
			limit = { check_variable = { which = $STEP$_DIGIT_2 value = 8 }}
			exist_mpj_society_research_S3 = { MPJ = $MPJ$ STEP_VALUE = $STEP_VALUE$8 }
		} else_if = {
			limit = { check_variable = { which = $STEP$_DIGIT_2 value = 9 }}
			exist_mpj_society_research_S3 = { MPJ = $MPJ$ STEP_VALUE = $STEP_VALUE$9 }
		}
	}
}

