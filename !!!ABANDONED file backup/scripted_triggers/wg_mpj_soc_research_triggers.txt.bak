exist_mpj_society_research = {
	if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 0 }}
		exist_mpj_society_research = { MPJ = $MPJ$ STEP_VALUE = 0 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 1 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 1 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 2 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 2 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 3 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 3 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 4 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 4 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 5 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 5 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 6 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 6 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 7 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 7 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 8 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 8 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 9 }}
		exist_mpj_society_research_S2 = { STEP = $STEP$ MPJ = $MPJ$ STEP_VALUE = 9 }
	}
}

exist_mpj_society_research_S2 = {
	if = {
		limit = { check_variable = { which = $STEP$_DIGITS value = 1 }}
		exist_mpj_society_research_S3 = { MPJ = $MPJ$ STEP_VALUE = $STEP_VALUE$ }
	}
	else_if = {
		limit = { check_variable = { which = $STEP$_DIGITS value > 1 }}
		if = {
			limit = { check_variable = { which = $STEP$_DIGIT_2 value = 0 }}
			exist_mpj_society_research_S3 = { MPJ = $MPJ$ STEP_VALUE = $STEP_VALUE$0 }
		} else_if = {
			limit = { check_variable = { which = $STEP$_DIGIT_2 value = 1 }}
			exist_mpj_society_research_S3 = { MPJ = $MPJ$ STEP_VALUE = $STEP_VALUE$1 }
