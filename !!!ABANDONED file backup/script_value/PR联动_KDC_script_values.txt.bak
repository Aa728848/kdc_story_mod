R_plnt_job_nano_tech_pts_factor = {
	base = 1
	modifier = {
		add = 0.5
		exists = owner
		owner = { has_policy_flag = gray_research_more_nano_points }
	}
	modifier = {
		subtract = 0.5
		exists = owner
		owner = { has_policy_flag = gray_research_less_nano_points }
	}
	mult = value:PR_prmt_sv_plnt_JOB_FACTOR|JOB|gray_nano_researcher|
	mult = PR_var_plnt_ULTILIZATION
	mult = owner.nanotech_points_per_pop_mult
}

# scope = planet
# （地块用）每个星球的人力所需的纳米维护
PR_D_planet_nanites_upkeep_FACTOR = {
	base = 1
	multiply = owner.PR_trait_nanites_upkeep_mult 
	multiply = PR_var_plnt_MAN
	modifier = {
		factor = 0.7
		has_active_building = building_nanite_field_manipulator
	}
}

