wg_major_project_next_page_effect = {
	potential = { always = yes }
	allow = {
		exist_mpj_step = { MPJ = wg_current_mpj MPJ_PAGE_START = wg_current_mpj_page_step_1 STEP = 4 }
	}
	effect = { hidden_effect = {
		change_variable = { which = wg_current_mpj_page value = 1 }
		set_variable = { which = wg_current_mpj_page_step_1 value = wg_current_mpj_page }
		multiply_variable = { which = wg_current_mpj_page_step_1 value = 4 }
		get_digits = { ARRAY = wg_current_mpj_page_step_1 VARIABLE = wg_current_mpj_page_step_1 }

		set_variable = { which = wg_current_mpj_page_step_2 value = wg_current_mpj_page_step_1 }
		change_variable = { which = wg_current_mpj_page_step_2 value = 1 }
		get_digits = { ARRAY = wg_current_mpj_page_step_2 VARIABLE = wg_current_mpj_page_step_2 }

