tr_domination_judgment_corps = {

	# effect implemented in jobs file

	tradition_swap = {
		name = tr_domination_trust_officers
		inherit_effects = yes
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_regular_empire = yes
			is_wg_empire = no
			OR = {
				is_egalitarian = yes
				AND = {
					is_authoritarian = no
					is_xenophobe = no
				}
			}
		}
		weight = {
			factor = 1
		}
	}

	# effect implemented in jobs file

	tradition_swap = {
		name = tr_domination_deviancy_protocols
		inherit_effects = no
		inherit_icon = no
		inherit_name = no
		trigger = {
			is_machine_empire = yes
		}
		modifier = {
			planet_crime_no_happiness_add = -10
		}
		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_domination_divergence_supression
		inherit_effects = no
		inherit_icon = no
		inherit_name = no
		trigger = {
			is_hive_empire = yes
		}
		modifier = {
			planet_crime_no_happiness_add = -10
		}
		weight = {
			factor = 1
		}
	}

	# 公信警督
	tradition_swap = {
		name = tr_wg_domination_peoples_police_officer
		inherit_effects = no
		inherit_icon = no
		inherit_name = no
		trigger = {
			is_wg_empire = yes
			NOR = {
				has_ethic = ethic_authoritarian
				has_ethic = ethic_fanatic_authoritarian
			}
		}
		modifier = {
			edict_length_mult = 0.2
			planet_stability_add = 5
		}

		weight = {
			weight = 99
		}
	}

	# 监督委员会
	tradition_swap = {
		name = tr_wg_domination_supervisory_committee
		inherit_effects = no
		inherit_icon = no
		inherit_name = no
		trigger = {
			is_wg_empire = yes
			OR = {
				has_ethic = ethic_authoritarian
				has_ethic = ethic_fanatic_authoritarian
			}
		}
		modifier = {
			edict_length_mult = 0.2
			planet_stability_add = 5
		}

		weight = {
			weight = 99
		}
	}

	ai_weight = {
		factor = 10
	}
}

