}

# 4
tr_prosperity_sct = {
	modifier = {
		planet_structures_cost_mult = -0.10
		planet_building_build_speed_mult = 0.25
	}

	tradition_swap = {
		name = tr_prosperity_sct_machine
		inherit_effects = yes
		inherit_icon = yes
		inherit_name = no
		trigger = {
			OR = {
				is_machine_empire = yes
				is_hive_empire = yes
			}
		}
		weight = {
			factor = 1
		}
	}

	# 妖精建设运营团队
	tradition_swap = {
		name = tr_wg_prosperity_fairy_construction_group
		inherit_effects = no
		inherit_icon = no
		inherit_name = no
		trigger = {
			is_wg_empire = yes
		}
		modifier = {
			planet_building_build_speed_mult = 0.25
			planet_structures_cost_mult = -0.10
			planet_structures_upkeep_mult = -0.10
		}
		weight = {
			weight = 99
		}
	}

	ai_weight = {
		factor = 1000
	}
}

