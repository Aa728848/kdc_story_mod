tr_prosperity_adopt = {
	modifier = {
		station_gatherers_produces_mult = 0.10
	}

	tradition_swap = {
		name = tr_prosperity_adopt_machine
		inherit_effects = no
		inherit_icon = yes
		inherit_name = yes
		trigger = {
			is_machine_empire = yes
		}
		modifier = {
			station_gatherers_produces_mult = 0.10
		}
		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_prosperity_adopt_hive
		inherit_effects = no
		inherit_icon = yes
		inherit_name = yes
		trigger = {
			is_hive_empire = yes
		}
		modifier = {
			station_gatherers_produces_mult = 0.10
		}
		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_wg_prosperity_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_wg_empire = yes
		}
		modifier = {
			station_gatherers_produces_mult = 0.15
			trade_value_mult = 0.15
		}
		weight = {
			weight = 99
		}
	}

	ai_weight = {
		factor = 10
		modifier = {
			factor = 5
			years_passed < 10
		}
		modifier = {
			factor = 2
			has_ethic = ethic_pacifist
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_pacifist
		}
		modifier = {
			factor = 0
			OR = {
				AND = {
					has_tradition = tr_diplomacy_adopt
					NOT = { has_tradition = tr_diplomacy_finish }
				}
				AND = {
					has_tradition = tr_discovery_adopt
					NOT = { has_tradition = tr_discovery_finish }
				}
				AND = {
					has_tradition = tr_domination_adopt
					NOT = { has_tradition = tr_domination_finish }
				}
				AND = {
					has_tradition = tr_expansion_adopt
					NOT = { has_tradition = tr_expansion_finish }
				}
				AND = {
					has_tradition = tr_harmony_adopt
					NOT = { has_tradition = tr_harmony_finish }
				}
				AND = {
					has_tradition = tr_supremacy_adopt
					NOT = { has_tradition = tr_supremacy_finish }
				}
			}
		}
	}
}

