tr_supremacy_adopt = {
	modifier = {
		country_starbase_capacity_add = 2
		army_damage_mult = 0.20
	}

	tradition_swap = {
		name = tr_supremacy_adopt_machine
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_machine_empire = yes
		}
		modifier = {
			country_starbase_capacity_add = 2
			army_damage_mult = 0.20
		}

		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_supremacy_adopt_hive
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_hive_empire = yes
		}
		modifier = {
			country_starbase_capacity_add = 2
			army_damage_mult = 0.20
		}

		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_wg_milltary_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_wg_empire = yes
		}
		modifier = {
			country_starbase_capacity_add = 3
			army_damage_mult = 0.25
		}

		weight = {
			weight = 99
		}
	}

	ai_weight = {
		factor = 10
		modifier = {
			factor = 2
			has_ethic = ethic_militarist
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_militarist
		}
		modifier = {
			factor = 2
			has_ethic = ethic_xenophobe
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_xenophobe
		}
		modifier = {
			factor = 0
			OR = {
				AND = {
					has_tradition = tr_diplomacy_adopt
					NOT = { has_tradition = tr_diplomacy_finish }
				}
				AND = {
					has_tradition = tr_discovery_adopt
					NOT = { has_tradition = tr_discovery_finish }
				}
				AND = {
					has_tradition = tr_domination_adopt
					NOT = { has_tradition = tr_domination_finish }
				}
				AND = {
					has_tradition = tr_expansion_adopt
					NOT = { has_tradition = tr_expansion_finish }
				}
				AND = {
					has_tradition = tr_harmony_adopt
					NOT = { has_tradition = tr_harmony_finish }
				}
				AND = {
					has_tradition = tr_prosperity_adopt
					NOT = { has_tradition = tr_prosperity_finish }
				}
			}
		}
	}
}

