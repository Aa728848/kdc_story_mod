
tr_discovery_adopt = {
	modifier = {
		ship_anomaly_research_speed_mult = 0.20
	}

	tradition_swap = {
		name = tr_discovery_adopt_machine
		inherit_effects = no
		#inherit_icon = no
		inherit_name = no
		trigger = {
			is_machine_empire = yes
		}
		modifier = {
			ship_anomaly_research_speed_mult = 0.20
		}

		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_discovery_adopt_hive
		inherit_effects = no
		#inherit_icon = no
		inherit_name = no
		trigger = {
			is_hive_empire = yes
		}
		modifier = {
			ship_anomaly_research_speed_mult = 0.20
		}

		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_wg_science_adopt
		inherit_effects = no
		inherit_name = no
		trigger = {
			is_wg_empire = yes
		}
		modifier = {
			ship_anomaly_generation_chance_mult = 0.1
		}

		weight = {
			weight = 99
		}
	}
	
	ai_weight = {
		factor = 10
		modifier = {
			factor = 5
			years_passed < 10
		}
		modifier = {
			factor = 2
			has_ethic = ethic_materialist
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_materialist
		}
		modifier = {
			factor = 0
			OR = {
				AND = {
					has_tradition = tr_diplomacy_adopt
					NOT = { has_tradition = tr_diplomacy_finish }
				}
				AND = {
					has_tradition = tr_domination_adopt
					NOT = { has_tradition = tr_domination_finish }
				}
				AND = {
					has_tradition = tr_expansion_adopt
					NOT = { has_tradition = tr_expansion_finish }
				}
				AND = {
					has_tradition = tr_harmony_adopt
					NOT = { has_tradition = tr_harmony_finish }
				}
				AND = {
					has_tradition = tr_prosperity_adopt
					NOT = { has_tradition = tr_prosperity_finish }
				}
				AND = {
					has_tradition = tr_supremacy_adopt
					NOT = { has_tradition = tr_supremacy_finish }
				}
			}
		}
	}
}

