tr_harmony_adopt = {
	modifier = {
		planet_pops_organics_food_upkeep_mult = -0.10
	}

	tradition_swap = {
		name = tr_synchronicity_machine_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_machine_empire = yes
		}
		modifier = {
			planet_pops_robotics_upkeep_mult = -0.10
		}
		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_synchronicity_hive_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_hive_empire = yes
			is_lithoid_empire = no
		}
		modifier = {
			planet_pops_organics_food_upkeep_mult = -0.10
		}
		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_harmony_lithoid_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_hive_empire = no
			is_lithoid_empire = yes
		}
		modifier = {
			planet_pops_organics_minerals_upkeep_mult = -0.10
		}
		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_synchronicity_lithoid_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_hive_empire = yes
			is_lithoid_empire = yes
		}
		modifier = {
			planet_pops_organics_minerals_upkeep_mult = -0.10
		}
		weight = {
			factor = 1
		}
	}

	# tradition_swap = {
	# 	name = tr_wg_administration_adopt
	# 	inherit_effects = no
	# 	inherit_icon = no
	# 	inherit_name = no
	# 	trigger = {
	# 		is_wg_empire = yes
	# 	}
	# 	modifier = {
	# 		planet_jobs_ruler_produces_mult = 0.3
	# 		governor_skill_levels = 2
	# 	}
	# 	weight = {
	# 		factor = 2
	# 	}
	# }

	ai_weight = {
		factor = 10
		modifier = {
			factor = 2
			has_ethic = ethic_egalitarian
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_egalitarian
		}
		modifier = {
			factor = 2
			has_ethic = ethic_authoritarian
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_authoritarian
		}
		modifier = {
			factor = 2
			has_ethic = ethic_spiritualist
		}
		modifier = {
			factor = 3
			has_ethic = ethic_fanatic_spiritualist
		}
		modifier = {
			factor = 0
			OR = {
				AND = {
					has_tradition = tr_diplomacy_adopt
					NOT = { has_tradition = tr_diplomacy_finish }
				}
				AND = {
					has_tradition = tr_discovery_adopt
					NOT = { has_tradition = tr_discovery_finish }
				}
				AND = {
					has_tradition = tr_domination_adopt
					NOT = { has_tradition = tr_domination_finish }
				}
				AND = {
					has_tradition = tr_expansion_adopt
					NOT = { has_tradition = tr_expansion_finish }
				}
				AND = {
					has_tradition = tr_prosperity_adopt
					NOT = { has_tradition = tr_prosperity_finish }
				}
				AND = {
					has_tradition = tr_supremacy_adopt
					NOT = { has_tradition = tr_supremacy_finish }
				}
			}
		}
	}
}

