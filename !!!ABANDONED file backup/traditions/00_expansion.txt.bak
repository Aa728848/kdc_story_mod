tr_expansion_adopt = {
	
	modifier = {
		planet_colony_development_speed_mult = 0.25
	}

	tradition_swap = {
		name = tr_expansion_adopt_machine
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_machine_empire = yes
		}
		modifier = {
			planet_colony_development_speed_mult = 0.25
		}

		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_expansion_adopt_hive
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_hive_empire = yes
		}
		modifier = {
			planet_colony_development_speed_mult = 0.25
		}

		weight = {
			factor = 1
		}
	}

	tradition_swap = {
		name = tr_wg_expansion_adopt
		inherit_effects = no
		inherit_icon = yes
		inherit_name = no
		trigger = {
			is_wg_empire = yes
		}
		modifier = {
			pop_resettlement_cost_mult = -0.3
		}

		weight = {
			weight = 99
		}
	}
	
	ai_weight = {
		factor = 10
		modifier = {
			factor = 5
			years_passed < 10
		}
		modifier = {
			factor = 0
			OR = {
				AND = {
					has_tradition = tr_diplomacy_adopt
					NOT = { has_tradition = tr_diplomacy_finish }
				}
				AND = {
					has_tradition = tr_discovery_adopt
					NOT = { has_tradition = tr_discovery_finish }
				}
				AND = {
					has_tradition = tr_domination_adopt
					NOT = { has_tradition = tr_domination_finish }
				}
				AND = {
					has_tradition = tr_harmony_adopt
					NOT = { has_tradition = tr_harmony_finish }
				}
				AND = {
					has_tradition = tr_prosperity_adopt
					NOT = { has_tradition = tr_prosperity_finish }
				}
				AND = {
					has_tradition = tr_supremacy_adopt
					NOT = { has_tradition = tr_supremacy_finish }
				}
			}
		}
	}
}

tr_expansion_finish = {
	modifier = {
		planet_non_artificial_max_districts_add = 1
		ascension_perks_add = 1
	}
}
