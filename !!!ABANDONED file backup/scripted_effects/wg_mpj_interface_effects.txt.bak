reset_mpj_page_variable = {
	set_variable = { which = wg_current_mpj_page value = 0 }
	set_variable = { which = wg_current_mpj_page_step_1 value = 0 }
	set_variable = { which = wg_current_mpj_page_step_2 value = 1 }
	set_variable = { which = wg_current_mpj_page_step_3 value = 2 }
	set_variable = { which = wg_current_mpj_page_step_4 value = 3 }
	get_digits = { ARRAY = wg_current_mpj_page_step_1 VARIABLE = wg_current_mpj_page_step_1 }
	get_digits = { ARRAY = wg_current_mpj_page_step_2 VARIABLE = wg_current_mpj_page_step_2 }
	get_digits = { ARRAY = wg_current_mpj_page_step_3 VARIABLE = wg_current_mpj_page_step_3 }
	get_digits = { ARRAY = wg_current_mpj_page_step_4 VARIABLE = wg_current_mpj_page_step_4 }
}

set_mpj_flag = {
	if = {
		limit = {
			check_variable = { which = $STEP$_DIGIT_1 value = 0 }
		}
		set_mpj_flag_S3 = { MPJ = $MPJ$ FLAG = $FLAG$ STEP_VALUE = 0 }
	} else_if = {
		limit = { check_variable = { which = $STEP$_DIGIT_1 value = 1 }}
		set_mpj_flag_S2 = { STEP = $STEP$ MPJ = $MPJ$ FLAG = $FLAG$ STEP_VALUE = 1 }
	} else_if = {
