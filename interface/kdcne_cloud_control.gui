guiTypes = {
    containerWindowType = {
        name = "kdcne_projector_option"
        size = { width = 452 height = 42 }
        moveable = no
        buttonType = {
            name = "option_button"
            quadTextureSprite = "GFX_event_button_452"
            position = { x = 0 y = 0 }
            font = "cg_16b"
            text = "OPTION_TEXT"
        }
        OverlappingElementsBoxType = {
            name = "trigger_icons"
            position = { x = 0 y = 4 }
            size = { x = 65 y = 28 }
        }

        OverlappingElementsBoxType = {
            name = "effect_icons"
            position = { x = 370 y = 8 }
            size = { x = 72 y = 28 }
            format = right
        }
    }
    # Keep the full native diplomatic-window widget contract: the engine binds
    # these widgets even when the projector does not display empire information.
    # Effect buttons stay at the window root so they receive map selection.
    containerWindowType = {
        name = "kdcne_projector_window"
        orientation = center
        origo = center
        moveable = yes
        size = { width = 680 height = 610 }
        background = { name = "background" quadTextureSprite = "GFX_tile_large_bg" }
        containerWindowType = {
            name = "EVENT_DIPLO"
            position = { x = 0 y = 0 }
            size = { width = 680 height = 610 }
            moveable = no
            instantTextBoxType = {
                name = "action_title"
                font = "malgun_goth_24"
                position = { x = 30 y = 24 }
                maxWidth = 620
                maxHeight = 40
                format = center
                alwaysTransparent = yes
            }
            instantTextBoxType = {
                name = "action_desc"
                font = "cg_16b"
                position = { x = 9999 y = 9999 }
                maxWidth = 600
                maxHeight = 185
                format = left
                alwaysTransparent = yes
            }
            listboxType = {
                name = "option_list"
                position = { x = 114 y = 440 }
                size = { x = 452 y = 140 }
                spacing = 0
                scrollbartype = "standardlistbox_slider"
                borderSize = { x = 0 y = 0 }
            }
        }
        effectButtonType = {
            name = "kdcne_lock_selected_system"
            position = { x = 104 y = 285 }
            spriteType = "GFX_standard_button_142_34_button"
            buttonFont = "cg_16b"
            text = kdcne_lock_target
            effect = kdcne_cloud_select_target
        }
        effectButtonType = {
            name = "kdcne_clear_selected_system"
            position = { x = 268 y = 285 }
            spriteType = "GFX_standard_button_142_34_button"
            buttonFont = "cg_16b"
            text = kdcne_clear_target
            effect = kdcne_cloud_clear_target
        }
        effectButtonType = {
            name = "kdcne_target_empty"
            position = { x = 114 y = 345 }
            spriteType = "GFX_event_button_452"
            buttonFont = "cg_16b"
            text = kdcne_target_empty
            effect = kdcne_cloud_target_empty
        }
        effectButtonType = {
            name = "kdcne_target_selected"
            position = { x = 114 y = 345 }
            spriteType = "GFX_event_button_452"
            buttonFont = "cg_16b"
            text = kdcne_target_selected
            effect = kdcne_cloud_target_selected
        }
        # Required standard diplomatic widgets are kept outside the visible panel.
        buttonType = { name = "confirm_button" position = { x = 9999 y = 9999 } quadTextureSprite = "GFX_standard_button_142_34_button" font = "cg_16b" text = "MESSAGE_OK" }
        instantTextBoxType = { name = "heading" position = { x = 9999 y = 9999 } font = "cg_16b" maxWidth = 620 maxHeight = 30 }
        buttonType = { name = "alien_message_background" position = { x = 9999 y = 9999 } size = { x = 620 y = 300 } spriteType = "GFX_tiles_dark_area_cut_8" }
        instantTextBoxType = {
            name = "alien_message"
            # Diplomatic country_event.desc is rendered here, not action_desc.
            position = { x = 40 y = 85 }
            font = "cg_16b"
            maxWidth = 600
            maxHeight = 185
            format = left
            # The diplomatic window resets this scroll position even while hidden.
            # Omitting the scrollbar leaves a null object in the native update.
            scrollbartype = "standardtext_slider"
        }
        containerWindowType = {
            name = "portrait_background"
            position = { x = 9999 y = 9999 }
            size = { width = 964 height = 350 }
            clipping = yes
            iconType = { name = "event_picture" spriteType = "GFX_diplomacy_portrait_frame" }
            iconType = { name = "portrait" spriteType = "GFX_portrait_character" position = { x = 250 y = 0 } }
        }

        # Native 4.5.3 bindings and complete child trees, hidden by root position.
        # Do not remove unused widgets: missing portrait/empire widgets can crash
        # the diplomatic event constructor. No hidden shortcut captures map keys.

        iconType = {
            name = "hex_bg"
            spriteType = "GFX_hex_bg"
            position = { x = 9999 y = 9999 }
            alwaysTransparent = yes
        }

        iconType = {
            name = "empire_header_line"
            quadTextureSprite = "GFX_line_long"
            position = { x = 9999 y = 9999 }
            alwaysTransparent = yes
        }

        buttonType = {
            name = "close"
            quadTextureSprite = "GFX_main_close_button"
            position = { x = 9999 y = 9999 }
            Orientation = "UPPER_RIGHT"
            clicksound = "back_click"
        }

        buttonType = {
            name = "focus_button"
            position = { x = 9999 y = 9999 }
            orientation = "UPPER_RIGHT"
            spriteType = "GFX_fleetview_focus"
            buttonFont = "cg_16b"

        }

        buttonType = {
            name = "tts_button"
            position = { x = 9999 y = 9999 }
