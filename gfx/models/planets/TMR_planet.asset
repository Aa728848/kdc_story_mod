#纳米城市星球#
entity = {
	name = "nanite_city_planet_01_entity"
	pdxmesh = "planet_clouded_mesh"
	
	meshsettings = {
	name = "planet_geosphereShape"
	texture_diffuse = "planet_shieled_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	##pole texture override
	meshsettings = {
	name = "polesShape"
	texture_diffuse = "planet_shieled_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	meshsettings = {
		name = "planet_geosphereShape"
		texture_diffuse = "nanite_city_planet_arthropoid_01_diffuse.png"
		texture_normal = "nanite_city_planet_arthropoid_01_normal.png"
		texture_specular = "nanite_city_planet_arthropoid_01_specular.png"
	}
	##cloud texture override
	meshsettings = {
		name = "clouds_geosphereShape"
		texture_diffuse = "##clouds_smog_01_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "nospec.dds"
	}
	##cloud shadow texture override
	meshsettings = {
		name = "clouds_shadow_geosphereShape"
		texture_diffuse = "##clouds_smog_shadow_01_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "nospec.dds"
	}
		##pole texture override
	meshsettings = {
		name = "polesShape"
		texture_diffuse = "poles_tropical_1_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "nospec.dds"
	}
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class_02" } }
	}
	
	#scale = 10
}

#建门者能源核心#
entity = {
	name = "shielded_planet2_01_entity"
	pdxmesh = "shielded_planet_mesh"
	
	meshsettings = {
	name = "planet_geosphereShape"
	texture_diffuse = "planet_shieled_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	##pole texture override
	meshsettings = {
	name = "polesShape"
	texture_diffuse = "planet_shieled_diffuse.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	##cloud texture override
	meshsettings = {
	name = "clouds_geosphereShape"
	texture_diffuse = "nanite_planet_shield_clouds.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	##cloud shadow texture override
	meshsettings = {
	name = "clouds_shadow_geosphereShape"
	texture_diffuse = "nanite_planet_shield_clouds.dds"
	texture_normal = "nonormal.dds"
	texture_specular = "nospec.dds"
	}
	
	
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class_02" } }
	}
	
	scale = 15
}